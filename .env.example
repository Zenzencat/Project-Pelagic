# Project Pelagic — environment variables for the ERA5 wind cross-check
# (src/analysis/era5_wind_check.py) and the Sentinel-1 multi-temporal
# comparison (src/analysis/sentinel1_revisit_check.py). Neither is wired
# into the live API yet -- these are standalone analysis scripts.
#
# Copy this file to .env (already gitignored) and fill in real values.
# Never commit .env.

# --- ERA5 / Copernicus Climate Data Store (CDS) ---
# Used by: src/analysis/era5_wind_check.py
# Free account required. Register at https://cds.climate.copernicus.eu,
# then get your personal API key from https://cds.climate.copernicus.eu/user
# (also requires accepting the "ERA5 hourly data on single levels" dataset's
# license on that dataset's page before the API will serve it). These two
# env vars match what the `cdsapi` Python package reads directly -- as an
# alternative to env vars, cdsapi also accepts a ~/.cdsapirc file in the
# same format; see https://cds.climate.copernicus.eu/how-to-api.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=your-personal-access-token-here

# --- Copernicus Data Space Ecosystem (CDSE) ---
# Used by: src/analysis/sentinel1_revisit_check.py (catalog *search* needs no
# auth at all -- these are only needed to actually download a matched
# Sentinel-1 product once found).
# Free account required. Register at https://dataspace.copernicus.eu, then
# register an OAuth2 client under your account settings to get a client ID
# and secret (client-credentials grant). Token endpoint:
# https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_CLIENT_ID=your-oauth2-client-id-here
CDSE_CLIENT_SECRET=your-oauth2-client-secret-here
